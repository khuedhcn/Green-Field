# Sao chép file này thành .env.local rồi điền giá trị thật.
# Lấy tại: Supabase Dashboard > Project Settings > API
# (.env.local đã được .gitignore bỏ qua nhờ pattern *.local)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Nguồn dữ liệu cho màn Raise Ticket. Mặc định (bỏ trống) = supabase.
# Chỉ đặt "flask" khi muốn chạy offline với backend SQLite trong /API.
# VITE_RAISE_TICKET_BACKEND=supabase
